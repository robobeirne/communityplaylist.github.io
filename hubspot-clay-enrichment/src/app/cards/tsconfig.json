{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "allowImportingTsExtensions": true,
    "esModuleInterop": true,
    "resolveJsonModule": true
  },
  "include": [
    "*.tsx",
    "lib/**/*.ts",
    "lib/**/*.tsx",
    "discovery/**/*.ts",
    "contact/**/*.ts",
    "orderform/**/*.ts"
  ],
  "exclude": [
    "lib/**/*.test.ts",
    "discovery/**/*.test.ts",
    "contact/**/*.test.ts",
    "orderform/**/*.test.ts"
  ]
}
