{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "allowImportingTsExtensions": true,
    "esModuleInterop": true
  },
  "include": ["*.tsx", "lib/**/*.ts", "lib/**/*.tsx", "discovery/**/*.ts"],
  "exclude": ["lib/**/*.test.ts", "discovery/**/*.test.ts"]
}
